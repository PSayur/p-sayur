<!DOCTYPE html>
<html lang="id"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0"><title>Admin P Sayur</title>
<style>body{margin:0;font-family:Arial;background:#f0fff2;padding:15px}h1{color:#1a9e3f}input{width:100%;padding:12px;margin:5px 0;border:1px solid #ccc;border-radius:8px;font-size:16px;box-sizing:border-box}.card{background:white;padding:15px;border-radius:12px;margin-bottom:10px;box-shadow:0 2px 8px #ccc}.btn{border:0;padding:10px 14px;border-radius:8px;font-weight:bold;color:white}.btn-hijau{background:#1a9e3f}.btn-merah{background:#e74c3c}.btn-biru{background:#0091ff}.row{display:flex;gap:8px}.row input{flex:1}.produk{display:flex;gap:10px;align-items:center}.produk img{width:70px;height:70px;object-fit:cover;border-radius:8px}</style></head>
<body><h1>Admin P Sayur</h1><p>Tambah / Edit Harga & Stok - Otomatis update di toko</p>
<div class="card"><b>Tambah Produk Baru</b><input id="nNama" placeholder="Nama, contoh: Bayam"><input id="nHarga" type="number" placeholder="Harga, contoh: 3000"><input id="nSatuan" placeholder="Satuan, contoh: ikat"><input id="nStok" type="number" placeholder="Stok, contoh: 50"><input id="nFoto" placeholder="Link Foto (boleh kosong)"><button class="btn btn-hijau" style="width:100%" onclick="tambah()">+ TAMBAH PRODUK</button></div>
<div id="list"></div>
<div class="card"><button class="btn btn-biru" style="width:100%" onclick="simpan()">SIMPAN SEMUA KE TOKO</button><br><br><a href="index.html" style="display:block;text-align:center">Lihat Toko -></a></div>
<script>
let API_URL='https://script.google.com/macros/s/AKfycbw7z4hp13slp6fc9Dias-R1anZXoTLr_emut-ymPUR_X3QWyhgM9Jdy9v_oBiC9MlXmmA/exec';
function fotoOtomatis(n){let x=(n||'').toLowerCase();if(x.includes('bayam'))return 'https://images.unsplash.com/photo-1576045057995-568f588f82fb?w=400';if(x.includes('wortel'))return 'https://images.unsplash.com/photo-1598170845058-32b9d6a5da37?w=400';return 'https://images.unsplash.com/photo-1540420773420-3366772f4999?w=400';}
let data=[];
function bersihin(l){let s=(l||'').trim();let m=s.match(/\[img\](.*?)\[\/img\]/i);if(m)return m[1].trim();let m2=s.match(/https?:\/\/[^\s\]\["']+/);if(m2)return m2[0];return s;}
async function load(){try{let r=await fetch(API_URL+'?t='+Date.now(),{cache:'no-store'});let rows=await r.json();if(Array.isArray(rows)&&rows.length>0){data=rows.map(x=>({name:x.Nama||'',harga:parseInt(String(x.Harga||'').replace(/[^0-9]/g,''))||1000,satuan:(x.Satuan||'ikat').toString().trim().toLowerCase(),stok:parseInt(String(x.Stok||'').replace(/[^0-9]/g,''))||50,img:bersihin(x.Foto||'')||fotoOtomatis(x.Nama)}));}}catch(e){}tampil();}
function tampil(){let h='';data.forEach((d,i)=>{h+='<div class="card produk"><img src="'+d.img+'"><div style="flex:1"><input value="'+d.name+'" onchange="data['+i+'].name=this.value"><div class="row"><input type="number" value="'+d.harga+'" onchange="data['+i+'].harga=parseInt(this.value)||0"><input value="'+d.satuan+'" onchange="data['+i+'].satuan=this.value"><input type="number" value="'+d.stok+'" onchange="data['+i+'].stok=parseInt(this.value)||0"></div><input value="'+d.img+'" onchange="data['+i+'].img=this.value" placeholder="Link Foto"></div><button class="btn btn-merah" onclick="hapus('+i+')">X</button></div>';});document.getElementById('list').innerHTML=h||'<p>Belum ada produk</p>';}
function tambah(){let n=document.getElementById('nNama').value.trim();if(!n)return alert('Isi nama dulu');data.unshift({name:n,harga:parseInt(document.getElementById('nHarga').value)||1000,satuan:document.getElementById('nSatuan').value.trim().toLowerCase()||'ikat',stok:parseInt(document.getElementById('nStok').value)||50,img:document.getElementById('nFoto').value.trim()||fotoOtomatis(n)});tampil();document.getElementById('nNama').value='';}
function hapus(i){if(confirm('Hapus '+data[i].name+'?')){data.splice(i,1);tampil();}}
async function simpan(){try{let body=data.map(d=>({nama:d.name,harga:d.harga,satuan:d.satuan,stok:d.stok,foto:d.img,kategori:'Sayur'}));await fetch(API_URL+'?t='+Date.now(),{method:'POST',mode:'no-cors',body:JSON.stringify(body)});alert('Tersimpan! Toko udah ke-update.');}catch(e){alert('Gagal simpan, cek internet');}}
load();
</script></body></html>
